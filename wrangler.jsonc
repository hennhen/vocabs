{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocabs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker serves the built PWA from dist/ and handles /api/* itself.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // INBOX holds words sent from the iOS share sheet until the app picks them up.
  // VAULT holds the phone's synced copy of the deck.
  "durable_objects": {
    "bindings": [
      { "name": "INBOX", "class_name": "Inbox" },
      { "name": "VAULT", "class_name": "Vault" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Inbox"] },
    { "tag": "v2", "new_sqlite_classes": ["Vault"] }
  ],
  // Workers AI, for word pronunciations (text-to-speech).
  "ai": { "binding": "AI" },
  // Preview builds (`wrangler preview`) need their bindings listed separately.
  "previews": { "ai": { "binding": "AI" } },
  "observability": { "enabled": true }
}
