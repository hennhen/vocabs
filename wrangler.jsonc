{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocabs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker serves the built PWA from dist/ and handles /api/* itself.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Holds words sent from the iOS share sheet until the app picks them up.
  "durable_objects": { "bindings": [{ "name": "INBOX", "class_name": "Inbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Inbox"] }],
  // Workers AI, for word pronunciations (text-to-speech).
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
